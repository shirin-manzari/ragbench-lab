# Markdown stays local for now; use git add -f PATH for an explicit exception.
*.[mM][dD]

# Local explanatory documents
[Rr][Ee][Aa][Dd][Mm][Ee]*
!README.md
[Pp][Rr][Oo][Jj][Ee][Cc][Tt]_[Dd][Ee][Ee][Pp]_[Dd][Ii][Vv][Ee]*
[Pp][Rr][Oo][Jj][Ee][Cc][Tt]-[Dd][Ee][Ee][Pp]-[Dd][Ii][Vv][Ee]*

# Local tests and test artifacts
tests/
test/
test_*.py
*_test.py
conftest.py
.pytest_cache/
.coverage
.coverage.*
htmlcov/
coverage.xml
junit*.xml

# Python and tooling
.venv/
__pycache__/
*.py[cod]
*.egg-info/
build/
dist/
.ruff_cache/
.mypy_cache/

# Secrets and local settings
.env
.env.*
!.env.example
.DS_Store

# JSON outputs stay local unless they are project configuration, frozen study
# metadata, or an explicitly allowlisted public results inventory below.
*.json
*.jsonl
!/configs/*.json
!/manifests/*.json

# Downloaded assets and generated experiment outputs
/data/
/models/
/indexes/
/runs/
/reports/
/artifacts/
*.log

# Only the reviewed public aggregate export belongs in results/.
/results/*
!/results/stage-b-v3/
/results/stage-b-v3/*
!/results/stage-b-v3/conditions.csv
!/results/stage-b-v3/cells.csv
!/results/stage-b-v3/contrasts.csv
