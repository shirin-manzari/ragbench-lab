  "exclusions": [
    "model weight files and Ollama blob store: reacquire using pinned model revisions/digests; access requirements still apply",
    "index arrays and chunk caches: rebuild from archived prepared corpora, source/config snapshots and pinned assets",
    "original downloaded native dataset JSON: prepared corpora/questions are included; source hashes/revisions remain pinned",
    "unrelated pilot/smoke attempts not explicitly listed; original workspace retains them",
    "historical v1/v2/v3 raw records, aggregates and archives remain separate; v3 manifest included only as sampling lineage",
    "saved local measurement snapshot contains exactly the fingerprinted Python sources, TOML configs and dependency files; current archive/analysis source differs and is packaged separately",
    "local raw archive only; no publication or off-device backup performed"
  ],
  "validation_commands": [
    "PYTHONPATH=src .venv/bin/python -m ragbench_lab study-archive configs/stage-a-study.toml --specification configs/archive-protocol-v4-50.json --output artifacts/archives/ragbench-core-v4-50.zip",
    "PYTHONPATH=src .venv/bin/python -m ragbench_lab archive-verify artifacts/archives/ragbench-core-v4-50.zip",
    "PYTHONPATH=src .venv/bin/python -m unittest discover -s tests -p 'test_archiv*.py' -v"
  ],
  "invariants": [
    "stream and fully exhaust every recorded hash chain; reject incomplete JSONL tails, duplicates and mixed run identities",
    "compare exact request-key sets, all three repetitions, source/condition/native/cache/context/resource controls and validation links",
    "primary runs are complete failure-free first attempts; historical incomplete runs and failures stay separate and visible",
    "verify prepared hashes/splits and source snapshots against recorded source-tree fingerprints",
    "project-relative explicit inputs only; reject traversal, symlinks, missing inputs and existing archive output",
    "stream ZIP copies and verify every member against inventory SHA-256; preserve any failed output for review",
    "do not mutate records, launch models, tune on held-out quality, or claim this archive includes model weights",
    "explicit saved local source tree must exactly reproduce measurement fingerprint; reject missing, extra, changed or symlinked fingerprint inputs; never silently substitute current source"
  ],
