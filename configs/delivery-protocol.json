  "trees": [
    {"path": "src/ragbench_lab", "suffixes": [".py"]},
    {"path": "configs", "suffixes": [".json", ".toml"]},
    {"path": "manifests", "suffixes": [".json"]},
    {"path": "reports/final-delivery-v1", "suffixes": [".md", ".json"]}
