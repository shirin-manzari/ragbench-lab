    {"role": "figures", "directory": "reports/stage-b-figures-v1", "proof": "artifacts/stage-b-figures-verification-v1.json", "kind": "independent_figure_checks", "identity_key": "figure_manifest_sha256", "manifest": "manifest.json"},
    {"role": "review", "directory": "reports/stage-b-failure-review-v1", "proof": "artifacts/stage-b-failure-review-verification-v1.json", "kind": "independent_failure_review_checks", "identity_key": "case_manifest_sha256", "manifest": "manifest.json"},
    {"role": "synthesis", "directory": "reports/study-synthesis-v1", "proof": "artifacts/study-synthesis-verification-v1.json", "kind": "independent_synthesis_checks", "identity_key": "synthesis_manifest_sha256", "manifest": "manifest.json"}
  ],
  "files": [
    "pyproject.toml", "requirements.lock", "README.md", "PROJECT_DEEP_DIVE.md", "report.md",
    "AGENTS.md", "PRD.md", "PLAN.md", "PROGRESS.md",
    "artifacts/check-analysis-v1.py", "artifacts/check-figures-v1.py",
    "artifacts/check-failure-review-v1.py", "artifacts/check-synthesis-v1.py",
    "artifacts/replay-delivery-v1.py",
    "tests/test_analysis.py", "tests/test_figures.py", "tests/test_failure_review.py",
    "tests/test_synthesis.py", "tests/test_archiving.py", "tests/test_delivery.py",
    "tests/test_answering.py", "tests/test_baselines_reranking.py", "tests/test_generation.py",
    "tests/test_stage_b_runner.py"
